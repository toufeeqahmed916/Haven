# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
VITE_API_URL=http://127.0.0.1:4000

# Phase 3 API configuration
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Preferred current Supabase server key (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy fallback only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Step 5 AI. Leave blank to use Haven's safe fallback.
# These are server-only values: never add VITE_ to them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_MS=12000

# Step 8 protection. Use TRUST_PROXY=true only behind Render/Railway/Vercel proxies.
RATE_LIMIT_MAX=300
TRUST_PROXY=false
